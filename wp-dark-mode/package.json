{
  "name": "wp-dark-mode",
  "version": "5.3.12",
  "main": "index.js",
  "scripts": {
    "admin-settings": "vite build --config ./src/admin/vite.settings.js",
    "admin-common": "vite build --config ./src/admin/vite.common.js",
    "admin-dashboard-widget": "vite build --config ./src/admin/vite.dashboard-widget.js",
    "admin-dark-mode": "vite build --config ./src/admin/vite.dark-mode.js",
    "admin-settings:css": "npx sass ./src/assets/admin-settings.scss ./src/assets/css/admin-settings-tmp.css",
    "admin-settings:tailwind": "npx tailwindcss -i ./src/assets/css/admin-settings-tmp.css -o ./assets/css/admin-settings.css -c ./src/admin/tailwind.settings.js --jitt --minify",
    "admin-common:css": "npx sass ./src/assets/admin-common.scss ./src/assets/css/admin-common-tmp.css",
    "admin-common:tailwind": "npx tailwindcss -i ./src/assets/css/admin-common-tmp.css -o ./assets/css/admin-common.css -c ./src/admin/tailwind.common.js --jitt --minify",
    "frontend:js": "vite build --config ./src/frontend/vite.config.js",
    "frontend:dark": "vite build --config ./src/frontend/vite.dark.js",
    "frontend:css": "npx sass ./src/assets/frontend.scss ./src/assets/css/frontend-tmp.css",
    "frontend:tailwind": "npx tailwindcss -i ./src/assets/css/frontend-tmp.css -o ./assets/css/app.min.css -c ./src/frontend/tailwind.config.js --jitt --minify",
    "social-share:js": "vite build --config ./src/social-share/vite.frontend.js",
    "social-share:css": "npx sass ./src/assets/social-share.scss ./src/assets/css/social-share-tmp.css",
    "social-share:tailwind": "npx tailwindcss -i ./src/assets/css/social-share-tmp.css -o ./assets/css/social-share.min.css -c ./src/social-share/tailwind.frontend.js --jitt --minify",
    "social-share-admin:js": "vite build --config ./src/social-share/vite.admin.js",
    "social-share-admin:css": "npx sass ./src/assets/admin-social-share.scss ./src/assets/css/admin-social-share-tmp.css",
    "social-share-admin:tailwind": "npx tailwindcss -i ./src/assets/css/admin-social-share-tmp.css -o ./assets/css/admin-social-share.min.css -c ./src/social-share/tailwind.admin.js --jitt --minify",
    "compile-themes": "npx sass ./src/assets/themes:./assets/css/themes --style compressed",
    "block:css": "npx sass ./src/gutenberg/style.scss ./src/gutenberg/tmp/style.css",
    "block:tailwind": "npx tailwindcss -i ./src/gutenberg/tmp/style.css -o ./assets/css/block.min.css -c ./src/gutenberg/tailwind.config.js --jitt --minify",
    "block:js": "npx wp-scripts build --config ./src/gutenberg/webpack.config.js -w",
    "build": "npm run admin-settings && npm run admin-settings:css && npm run admin-settings:tailwind && npm run admin-common && npm run admin-common:css && npm run admin-common:tailwind && npm run frontend:js && npm run frontend:css && npm run frontend:tailwind && npm run social-share:js && npm run social-share:css && npm run social-share:tailwind && npm run social-share-admin:js && npm run social-share-admin:css && npm run social-share-admin:tailwind",
    "make-pot": "wp i18n make-pot . languages/wp-dark-mode.pot",
    "makepot-vue": "npx wpvuei18n makepot"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "description": "",
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-react-jsx": "^7.22.15",
    "@babel/preset-env": "^7.23.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.7",
    "@vitejs/plugin-vue": "^5.2.3",
    "@wordpress/block-editor": "^13.2.0",
    "@wordpress/scripts": "^19.2.4",
    "alpinejs": "^3.13.2",
    "autoprefixer": "^10.4.14",
    "axios": "^1.6.0",
    "babel-loader": "^9.1.3",
    "chart.js": "^4.4.0",
    "css-loader": "^6.8.1",
    "darkreader": "^4.9.85",
    "mini-css-extract-plugin": "^2.7.6",
    "pinia": "^2.1.6",
    "sass": "^1.64.2",
    "suncalc": "^1.9.0",
    "tailwind-scrollbar": "^3.0.5",
    "tailwindcss": "^3.3.3",
    "vite": "^6.3.4",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.2.36",
    "vue-router": "^4.2.4",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "wp-vue-i18n": "^1.1.4"
  },
  "dependencies": {
    "custom-switch": "^1.0.2"
  }
}
